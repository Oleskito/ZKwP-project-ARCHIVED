# ==============================================================================
# Przydomek.pl - Przykładowa konfiguracja środowiskowa (.env.example)
# Skopiuj ten plik jako .env i uzupełnij własnymi danymi:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
# Wygeneruj unikalny klucz w Pythonie:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY="twoj-unikalny-tajny-klucz-django-nie-udostepniaj-publicznie"

# Ustaw False na produkcji
DEBUG=True

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=project_db
DB_USER=postgres
DB_PASSWORD=twoje_bezpieczne_haslo_bazy
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# Field-Level Encryption (PII Security)
# ------------------------------------------------------------------------------
# Klucz Fernet (32 bajty zakodowane w base64) używany przez django-encrypted-model-fields
# do szyfrowania danych wrażliwych (np. PESEL / nr dowodu nabywców szczeniąt w modelu Buyer).
# Wygeneruj w Pythonie:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FIELD_ENCRYPTION_KEY="twoj-klucz-fernet-wygenerowany-kryptograficznie="

# ------------------------------------------------------------------------------
# Cloudflare Turnstile (Ochrona CAPTCHA formularzy logowania i rejestracji)
# ------------------------------------------------------------------------------
# Klucze z panelu Cloudflare Turnstile (dla testów lokalnych możesz użyć dummy keys Cloudflare)
# https://developers.cloudflare.com/turnstile/reference/testing/
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ------------------------------------------------------------------------------
# Stripe Payments & Subscriptions
# ------------------------------------------------------------------------------
# Klucze testowe ze Stripe Dashboard (Developer -> API keys / Webhooks)
# https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLIC_KEY=pk_test_twoj_klucz_publiczny_stripe
STRIPE_SECRET_KEY=sk_test_twoj_klucz_prywatny_stripe
STRIPE_WEBHOOK_SECRET=whsec_twoj_klucz_podpisywania_webhookow_stripe
